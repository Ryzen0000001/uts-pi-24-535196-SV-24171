# Salin berkas ini menjadi .env, lalu isi nilainya.
# .env tidak ikut di-commit (lihat .gitignore).

# Hasilkan dengan: php artisan key:generate --show (dari folder backend)
APP_KEY=

# Alamat aplikasi yang dibuka di browser (frontend Nginx).
APP_URL=http://localhost:8080

# Kredensial MySQL. Nilai ini dipakai oleh service db dan backend.
DB_DATABASE=buku_servis
DB_USERNAME=buku_servis
DB_PASSWORD=
DB_ROOT_PASSWORD=
