{
  "info": {
    "name": "Buku Servis API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Jalankan Login terlebih dahulu; token otomatis tersimpan di variabel koleksi dan dikirim sebagai Bearer token."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "logId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Service Logs",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/service-logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service-logs"
              ]
            }
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/service-logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service-logs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motor\": \"Vario 125\",\n  \"serviced_at\": \"2026-10-12\",\n  \"odometer_km\": 24310,\n  \"service_type\": \"Ganti oli mesin\",\n  \"cost\": 55000,\n  \"workshop\": \"AHASS Sleman\",\n  \"notes\": \"Contoh dari Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('logId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create (invalid, expect 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/service-logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service-logs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motor\": \"\",\n  \"serviced_at\": \"2026-10-12\",\n  \"odometer_km\": \"banyak\",\n  \"service_type\": \"Ganti oli mesin\",\n  \"cost\": 55000,\n  \"workshop\": \"AHASS Sleman\",\n  \"notes\": \"Contoh dari Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Show",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/service-logs/{{logId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service-logs",
                "{{logId}}"
              ]
            }
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/service-logs/{{logId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service-logs",
                "{{logId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motor\": \"Vario 125\",\n  \"serviced_at\": \"2026-10-12\",\n  \"odometer_km\": 24310,\n  \"service_type\": \"Ganti oli mesin\",\n  \"cost\": 75000,\n  \"workshop\": \"AHASS Sleman\",\n  \"notes\": \"Contoh dari Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/service-logs/{{logId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service-logs",
                "{{logId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tanpa token (expect 401)",
      "item": [
        {
          "name": "List tanpa token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/service-logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service-logs"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
